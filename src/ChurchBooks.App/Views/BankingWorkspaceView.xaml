<UserControl x:Class="ChurchBooks.App.Views.BankingWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:ChurchBooks.App.Views">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Banking &amp; Deposits" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Manage bank accounts, group recorded contributions into deposits, preview balanced Fund-aware journals, and reconcile statement activity." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
   <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh"/>
  </Grid>
  <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
   <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="12"><StackPanel><TextBlock Text="Active Accounts" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding ActiveBankCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="12"><StackPanel><TextBlock Text="Book Balance" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding TotalBookBalanceDisplay}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="12"><StackPanel><TextBlock Text="Draft Deposits" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding DraftDepositCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Padding="12"><StackPanel><TextBlock Text="Posted Deposits" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding PostedDepositCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
  </UniformGrid>
  <TabControl Grid.Row="2">
   <TabItem Header="{Binding BankAccountPluralLabel}">
    <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CardStyle}" Padding="10">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="Bank Accounts" FontSize="16" FontWeight="SemiBold"/>
       <Grid Grid.Row="1" Margin="0,10,0,0">
        <DataGrid ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBankAccount}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Institution" Binding="{Binding Institution}" Width="*" MinWidth="140"/><DataGridTextColumn Header="Account" Binding="{Binding MaskedNumber}" Width="100"/><DataGridTextColumn Header="Book Balance" Binding="{Binding BalanceDisplay}" Width="130"/></DataGrid.Columns></DataGrid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
         <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding BankAccounts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
         <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE825;" FontSize="34" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
         <TextBlock Text="No bank accounts yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
         <TextBlock Text="Add the church's first bank account using the form on the right. Deposits and reconciliation will then become available." Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
       </Grid>
      </Grid>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14"><StackPanel>
      <TextBlock Text="Add Bank Account" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Create the financial account record; no transaction is posted by this form." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
      <TextBlock Text="Account name" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding BankName}" Margin="0,0,0,10"/>
      <TextBlock Text="Institution" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding InstitutionName}" Margin="0,0,0,10"/>
      <TextBlock Text="Last four digits" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding LastFour}" Margin="0,0,0,10"/>
      <TextBlock Text="Ledger code / name" Style="{StaticResource FieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding LedgerCode}"/><TextBox Grid.Column="2" Text="{Binding LedgerName}"/></Grid>
      <Button Command="{Binding AddBankAccountCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Add Bank Account" Margin="0,12,0,0"/>
     </StackPanel></Border>
    </Grid>
   </TabItem>
   <TabItem Header="{Binding DepositPluralLabel}">
    <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CardStyle}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Available recorded contributions" FontSize="16" FontWeight="SemiBold"/><DataGrid Grid.Row="1" Margin="0,10,0,10" ItemsSource="{Binding AvailableContributions}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Use" Binding="{Binding IsSelected}" Width="50"/><DataGridTextColumn Header="Contribution" Binding="{Binding Display}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding AmountDisplay}" IsReadOnly="True" Width="110"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2"><TextBlock Text="Deposit to" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBankAccount}" DisplayMemberPath="Name"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding DepositDate}"/><TextBox Grid.Column="2" Text="{Binding DepositReference}" ToolTip="Deposit slip/reference"/><Button Grid.Column="4" Command="{Binding CreateDepositCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Create Draft Deposit"/></Grid></StackPanel></Grid></Border>
     <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Deposit queue" FontSize="16" FontWeight="SemiBold"/><DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Deposits}" SelectedItem="{Binding SelectedDeposit}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding DepositDate}" Width="100"/><DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="{Binding PostingPreview}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"><Button Command="{Binding PreviewDepositCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Preview Journal" Margin="0,0,8,0"/><Button Command="{Binding PostDepositCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Post Deposit"/></StackPanel></Grid></Border>
    </Grid>
   </TabItem>
   <TabItem Header="Reconciliation"><views:BankReconciliationView DataContext="{Binding Reconciliation}"/></TabItem>
   <TabItem Header="Category → Income Mapping"><Border Style="{StaticResource CardStyle}" Margin="10" Padding="14"><StackPanel><TextBlock Text="Giving Category → Income Mapping" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Every active Giving Category must map to an Income account before a deposit can post. First-time setup creates a safe starter mapping; accountants can revise it here." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding GivingCategories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name"/><TextBlock Grid.Column="1" Text="→" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/><ComboBox Grid.Column="2" ItemsSource="{Binding IncomeAccounts}" SelectedItem="{Binding SelectedIncomeAccount}" DisplayMemberPath="Name"/><Button Grid.Column="4" Command="{Binding SaveCategoryMappingCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Save Mapping"/></Grid></StackPanel></Border></TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
 </Grid>
</UserControl>
