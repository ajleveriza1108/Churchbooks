<UserControl x:Class="ChurchBooks.App.Views.ExpensesWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ChurchBooks.App.Behaviors">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Expenses &amp; Vendors" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Maintain vendor records and post direct bank-paid expenses only after explicit review. Every posted expense remains balanced and Fund-aware." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
   <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh"/>
  </Grid>
  <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
   <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="12"><StackPanel><TextBlock Text="Active Vendors" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding ActiveVendorCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="12"><StackPanel><TextBlock Text="Draft Expenses" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding DraftExpenseCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="12"><StackPanel><TextBlock Text="Posted Expenses" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding PostedExpenseCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Padding="12"><StackPanel><TextBlock Text="Posted Total" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding PostedExpenseTotalDisplay}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
  </UniformGrid>
  <TabControl Grid.Row="2">
   <TabItem Header="Vendors">
    <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CardStyle}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Vendor Directory" FontSize="16" FontWeight="SemiBold"/><Grid Grid.Row="1" Margin="0,10,0,0"><DataGrid ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedVendor}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="Vendor" Binding="{Binding Name}" Width="*" MinWidth="180"/><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" MinWidth="170"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Vendors.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="34" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock Text="No vendors yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="Add the first vendor on the right. Vendor records do not post accounting by themselves." Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid></Grid></Border>
     <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Vendor Details" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Basic information" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="Code" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding VendorCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,9"/><TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding VendorName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,9"/><TextBlock Text="Tax / compliance" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,7,0,8"/><TextBlock Text="Tax ID" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding VendorTaxId}" Margin="0,0,0,9"/><TextBlock Text="Contact" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,7,0,8"/><TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding VendorEmail}" Margin="0,0,0,9"/><TextBlock Text="Phone" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding VendorPhone}"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Command="{Binding AddVendorCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Save Vendor" Margin="0,0,8,0"/><Button Command="{Binding ToggleVendorStatusCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding VendorActionLabel}"/></StackPanel></StackPanel></ScrollViewer></Border>
    </Grid>
   </TabItem>
   <TabItem Header="Direct Expenses">
    <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CardStyle}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="New Direct Expense" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Money leaves a bank account now. Bills and Accounts Payable remain separate from this explicit direct-expense workflow." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="Bank account" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBankAccount}" DisplayMemberPath="Name" Margin="0,0,0,8"/><TextBlock Text="Vendor (optional)" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedVendor}" DisplayMemberPath="Name" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding ExpenseDate}"/><TextBox Grid.Column="2" Text="{Binding ExpenseReference}" ToolTip="Reference"/></Grid><TextBox Margin="0,8,0,0" Text="{Binding ExpenseMemo}" ToolTip="Memo"/><Separator Margin="0,12"/><TextBlock Text="Expense line" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding ExpenseAccounts}" SelectedItem="{Binding SelectedExpenseAccount}" DisplayMemberPath="Name" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Funds}" SelectedItem="{Binding SelectedFund}" DisplayMemberPath="Name" Margin="0,8,0,0"/><TextBox Margin="0,8,0,0" Text="{Binding LineDescription}" ToolTip="Description"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding LineAmount, UpdateSourceTrigger=PropertyChanged}" behaviors:AccountingAmountTextBoxBehavior.IsEnabled="True" HorizontalContentAlignment="Right" ToolTip="Amount. Digits, comma grouping, and one decimal point are accepted; display format is x,xxx.xx."/><Button Grid.Column="2" Command="{Binding AddExpenseLineCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Add Line"/></Grid><DataGrid Height="150" Margin="0,10,0,0" ItemsSource="{Binding DraftLines}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Account" Binding="{Binding AccountDisplay}" Width="*"/><DataGridTextColumn Header="Fund" Binding="{Binding FundDisplay}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="90"/><DataGridTemplateColumn Header="" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Remove" Command="{Binding DataContext.RemoveExpenseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Draft total: " VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding DraftLineTotalDisplay}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="1" Command="{Binding CreateExpenseCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Create Draft Expense"/></Grid></StackPanel></ScrollViewer></Border>
     <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Expense Queue" FontSize="16" FontWeight="SemiBold"/><DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate}" Width="95"/><DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="{Binding PostingPreview}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"><Button Command="{Binding PreviewExpenseCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Preview Journal" Margin="0,0,8,0"/><Button Command="{Binding PostExpenseCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Post Expense"/></StackPanel><Border Grid.Row="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,12,0,0"><TextBlock Text="Import safety: Smart Import never posts expenses automatically and never creates vendors silently. Posting here is always an explicit action. Bills/payables are intentionally reserved for the next phase; this Phase 10 workspace remains direct bank-paid expenses only." TextWrapping="Wrap"/></Border></Grid></Border>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
 </Grid>
</UserControl>
