<UserControl x:Class="ChurchBooks.App.Views.GivingWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ChurchBooks.App.Controls"
             xmlns:behaviors="clr-namespace:ChurchBooks.App.Behaviors"
             xmlns:converters="clr-namespace:ChurchBooks.App.Converters"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Giving" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Record contributions against an open service batch, split them by giving category and fund, and review individual giving analytics." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Margin="12,0,0,0"/>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Record Giving">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Service &amp; Donor" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Margin="0,10,0,5" Style="{StaticResource FieldLabelStyle}">
                                        <Hyperlink Command="{Binding DataContext.ShowServicesCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Open Services to create or manage service batches.">Open service batch</Hyperlink>
                                    </TextBlock>
                                    <ComboBox Grid.Row="2" ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" DisplayMemberPath="Name" Style="{StaticResource InputComboBoxStyle}" ToolTip="Choose an open service batch. Closed batches are not shown here." automation:AutomationProperties.Name="Selected open service batch"/>
                                    <TextBlock Grid.Row="3" Margin="0,12,0,5" Style="{StaticResource FieldLabelStyle}">
                                        <Hyperlink Command="{Binding DataContext.ShowMembersCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Open Members to register or edit donors and members.">Donor / member</Hyperlink>
                                    </TextBlock>
                                    <ComboBox Grid.Row="4" ItemsSource="{Binding Donors}" SelectedItem="{Binding SelectedPerson}" Style="{StaticResource InputComboBoxStyle}" ToolTip="Select a registered donor or member. ChurchBooks reloads the people directory whenever Giving opens; register or edit people in Members." automation:AutomationProperties.Name="Donor or member">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <Binding>
                                                            <Binding.Converter><converters:PersonFullNameConverter/></Binding.Converter>
                                                        </Binding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Reference &amp; Memo (Optional)" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="Envelope / receipt / reference (optional)" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,5" ToolTip="Optional envelope number, receipt number, or external reference."/>
                                    <TextBox Grid.Row="2" Text="{Binding ContributionReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" ToolTip="Optional. Leave blank when no envelope, receipt, or reference exists." automation:AutomationProperties.Name="Optional envelope receipt or reference"/>
                                    <TextBlock Grid.Row="3" Text="Memo (optional)" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5" ToolTip="Optional internal note for this giving entry."/>
                                    <TextBox Grid.Row="4" Text="{Binding ContributionMemo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" ToolTip="Optional internal memo. This field never blocks recording when blank." automation:AutomationProperties.Name="Optional contribution memo"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Breakdown by Giving Category + Fund" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Select only categories and funds configured by your church. New breakdown rows start blank so ChurchBooks never repeats Tithes automatically." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}" ToolTip="Giving categories are configured in Settings → Giving Setup.">
                                        <Hyperlink Command="{Binding DataContext.ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}">Giving Category</Hyperlink>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Margin="8,0" Style="{StaticResource FieldLabelStyle}" ToolTip="Funds are configured in Fund Manager. Click to open Funds.">
                                        <Hyperlink Command="{Binding DataContext.ShowFundsCommand, RelativeSource={RelativeSource AncestorType=Window}}">Fund</Hyperlink>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="Amount" Style="{StaticResource FieldLabelStyle}" ToolTip="Contribution amount. Digits, comma grouping, and one decimal point are accepted; display format is x,xxx.xx."/>
                                    <TextBlock Grid.Column="3" Text="Action" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding BreakdownLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding DataContext.GivingCategories, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding GivingCategory}" DisplayMemberPath="Name" Style="{StaticResource InputComboBoxStyle}" ToolTip="Choose a configured giving category. Use Settings → Giving Setup to add or rename categories." automation:AutomationProperties.Name="Giving category"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Funds, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Fund}" DisplayMemberPath="Name" Style="{StaticResource InputComboBoxStyle}" Margin="8,0" ToolTip="Choose the designated fund. Use Fund Manager to configure funds." automation:AutomationProperties.Name="Fund"/>
                                                <TextBox Grid.Column="2" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" HorizontalContentAlignment="Right" behaviors:AccountingAmountTextBoxBehavior.IsEnabled="True" ToolTip="Enter the contribution amount using digits, optional comma thousands separators, and one decimal point. ChurchBooks formats the value as x,xxx.xx." automation:AutomationProperties.Name="Offering amount"/>
                                                <Button Grid.Column="3" Command="{Binding DataContext.RemoveBreakdownLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Content="Remove" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Command="{Binding AddBreakdownLineCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Add Breakdown Row" ToolTip="Add a blank category/fund/amount row. New categories are created in Settings, not inside a transaction."/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="Total" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding DraftTotalDisplay}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                    <Button Grid.Column="3" Command="{Binding SaveContributionCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Record Offering" ToolTip="Record the giving entry after selecting an open service batch, donor, giving category, fund, and amount."/>
                                </Grid>
                                <TextBlock Text="{Binding EntryError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EntryError}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding EntryError}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Individual Analytics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Donors}" SelectedItem="{Binding SelectedPerson}" Style="{StaticResource InputComboBoxStyle}" automation:AutomationProperties.Name="Analytics individual" ToolTip="Select a donor or member using the complete given and last name. People are refreshed whenever Giving opens.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <Binding>
                                                    <Binding.Converter><converters:PersonFullNameConverter/></Binding.Converter>
                                                </Binding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding AnalyticsAsOfDate}" Margin="8,0"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Granularities}" SelectedItem="{Binding SelectedGranularity}" Style="{StaticResource InputComboBoxStyle}" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding ChartKinds}" SelectedItem="{Binding SelectedChartKind}" Style="{StaticResource InputComboBoxStyle}" Margin="0,0,8,0" automation:AutomationProperties.Name="Offering graph type"/>
                            <Button Grid.Column="4" Command="{Binding RefreshAnalyticsCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh"/>
                        </Grid>

                        <TextBlock Text="Selected Individual" FontWeight="SemiBold"/>
                        <UniformGrid Columns="4" Margin="0,6,0,12">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="This Week" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding PersonWeekTotal}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="This Month" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding PersonMonthTotal}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="This Year" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding PersonYearTotal}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="All Time" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding PersonAllTimeTotal}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                        </UniformGrid>

                        <TextBlock Text="Whole Church" FontWeight="SemiBold"/>
                        <UniformGrid Columns="3" Margin="0,6,0,12">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Week Total" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding ChurchWeekTotal}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Month Total" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding ChurchMonthTotal}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Year Total" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding ChurchYearTotal}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding ChartCaption}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <controls:OfferingChartControl Points="{Binding ChartPoints}" ChartKind="{Binding SelectedChartKind}" Height="300"/>
                                <TextBlock Text="Pie and Donut show the selected period's giving-category breakdown. Line, Column, Bar, and Area show time trends." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
