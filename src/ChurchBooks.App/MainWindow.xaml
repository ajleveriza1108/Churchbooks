<Window x:Class="ChurchBooks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:views="clr-namespace:ChurchBooks.App.Views"
        xmlns:controls="clr-namespace:ChurchBooks.App.Controls"
        xmlns:behaviors="clr-namespace:ChurchBooks.App.Behaviors"
        xmlns:converters="clr-namespace:ChurchBooks.App.Converters"
        Title="ChurchBooks Pro"
        Icon="Assets/Brand/ChurchBooks.ico"
        Width="1600"
        Height="900"
        MinWidth="1180"
        MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:PersonFullNameConverter x:Key="PersonFullNameConverter" />
        <Style x:Key="ShellNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Height" Value="43" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="Padding" Value="12,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Width" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="DashboardCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="DashboardSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KpiTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ModeButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="13,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="QuickActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="MinHeight" Value="27" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Approved ChurchBooks Pro left navigation shell. -->
        <Border Grid.Column="0" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,8,10,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Image Source="Assets/Brand/ChurchBooks-AppIcon-256.png" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="Church" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Books" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="6,3" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="PRO" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,6">
                        <Button Style="{StaticResource ShellNavButtonStyle}" Tag="{Binding IsDashboardVisible}" Command="{Binding ShowDashboardCommand}" automation:AutomationProperties.Name="Open Dashboard">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE80F;"/><TextBlock Text="Dashboard" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Tag="{Binding IsServicesVisible}" Command="{Binding ShowServicesCommand}" ToolTip="Service and offering batches" automation:AutomationProperties.Name="Open Services">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE787;"/><TextBlock Text="{Binding SetupWorkspace.ServicePlural}" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Tag="{Binding IsGivingVisible}" Command="{Binding ShowGivingCommand}" automation:AutomationProperties.Name="Open Giving and individual offering analytics">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xEB51;"/><TextBlock Text="Giving" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Tag="{Binding IsPeopleVisible}" Command="{Binding ShowPeopleCommand}" automation:AutomationProperties.Name="Open Members and Giving Directory">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE716;"/><TextBlock Text="{Binding SetupWorkspace.MemberPlural}" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Tag="{Binding IsFundsVisible}" Command="{Binding ShowFundsCommand}" automation:AutomationProperties.Name="Open Fund Manager">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE8C7;"/><TextBlock Text="{Binding SetupWorkspace.FundPlural}" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Tag="{Binding IsBankingVisible}" Command="{Binding ShowBankingCommand}" automation:AutomationProperties.Name="Open Banking and Deposits">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE825;"/><TextBlock Text="Banking" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Tag="{Binding IsExpensesVisible}" Command="{Binding ShowExpensesCommand}" automation:AutomationProperties.Name="Open Expenses and Vendors">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE8C4;"/><TextBlock Text="Expenses" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShellNavButtonStyle}" IsEnabled="False" ToolTip="Planned for a later phase."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE9D9;"/><TextBlock Text="Budgets" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Tag="{Binding IsReportsVisible}" Command="{Binding ShowReportsCommand}" automation:AutomationProperties.Name="Open Reports Center">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE9D2;"/><TextBlock Text="Reports" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShellNavButtonStyle}" IsEnabled="False" ToolTip="BIR/tax workflow is planned; this test build does not fabricate filing status."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE8A5;"/><TextBlock Text="Tax Center" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Tag="{Binding IsIntegrityVisible}" Command="{Binding ShowIntegrityCommand}" automation:AutomationProperties.Name="Open Audit and Integrity">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE83D;"/><TextBlock Text="Audit" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShellNavButtonStyle}" Tag="{Binding IsSetupVisible}" Command="{Binding ShowSetupCommand}" automation:AutomationProperties.Name="Open Setup and Personalization">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE713;"/><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="10,6,10,8" Style="{StaticResource DashboardCardStyle}" Background="{DynamicResource ShellMutedBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Height="42">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="38" Height="38">
                                <Border CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE825;" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding OrganizationLogoPath}" Stretch="Uniform" Margin="2"/>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding SetupWorkspace.OrganizationDisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" VerticalAlignment="Center" Margin="7,0,0,0" ToolTip="{Binding SetupWorkspace.OrganizationDisplayName}"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TaxIdentifierDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Text="{Binding FiscalYearDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="3" Text="Local-first books" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="0,4,0,0" />
                        <Button Grid.Row="5" Command="{Binding ShowSetupCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Organization Settings" Padding="8,5" FontSize="10" Margin="0,6,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource WindowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Approved compact command/search/period/currency/user bar. -->
            <Border Grid.Row="0" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" MinWidth="170" />
                        <ColumnDefinition Width="215" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="122" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,8,0" Background="{DynamicResource SurfaceBrush}" ToolTip="{Binding SetupWorkspace.OrganizationDisplayName}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                            <Grid Width="22" Height="22" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE825;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/><Image Source="{Binding OrganizationLogoPath}" Stretch="Uniform"/></Grid>
                            <TextBlock Grid.Column="1" Text="{Binding SetupWorkspace.OrganizationAcronym}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="⌄" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Margin="0,0,8,0">
                        <TextBox Style="{StaticResource InputTextBoxStyle}" Padding="34,6,8,6" Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Search transactions members reports and features" ToolTip="Search ChurchBooks features and familiar terminology">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding RunGlobalSearchCommand}" /></TextBox.InputBindings>
                        </TextBox>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock Text="Search transactions, members, reports..." Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GlobalSearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,0,10,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Current Period" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" />
                            <TextBlock Text="{Binding CurrentPeriod}" FontWeight="SemiBold" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="8,4" Padding="6">
                        <TextBlock Text="{Binding SetupWorkspace.BaseCurrency}" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Margin="6,0,0,0"><TextBlock Text="Multi-Currency" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="Configured by transaction" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8"/></StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="5" Margin="8,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"><TextBlock Text="CB" Foreground="{DynamicResource AccentContrastBrush}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"><TextBlock Text="Local User" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="Administrator" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- The dashboard below follows docs/reference/ChurchBooks-Approved-Dashboard.png.
                     Every financial value is bound to current ChurchBooks data; unavailable tax/backup features are explicitly identified instead of fabricated. -->
                <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- Dashboard is intentionally a one-screen workspace: no dashboard ScrollViewer.
                         Flexible primary/activity rows shrink to the supported minimum window while
                         the KPI, mode, and readiness rows remain compact and fully visible. -->
                    <Grid Margin="12,6,12,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="76" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="1.05*" MinHeight="162" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" MinHeight="150" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="100" />
                        </Grid.RowDefinitions>

                            <!-- KPI row -->
                            <UniformGrid Grid.Row="0" Columns="5">
                                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,8,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Top"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB51;" Foreground="{DynamicResource SuccessBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Total Giving This Month" Style="{StaticResource KpiTitleStyle}"/><TextBlock Text="{Binding GivingWorkspace.ChurchMonthTotal}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Text="Recorded giving data" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,8,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource DangerSoftBrush}" VerticalAlignment="Top"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C4;" Foreground="{DynamicResource DangerBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Total Posted Expenses" Style="{StaticResource KpiTitleStyle}"/><TextBlock Text="{Binding ExpensesWorkspace.PostedExpenseTotalDisplay}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource DangerBrush}"/><TextBlock Text="Explicitly posted expenses" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,8,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource TealSoftBrush}" VerticalAlignment="Top"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" Foreground="{DynamicResource TealBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Net Funds" Style="{StaticResource KpiTitleStyle}"/><TextBlock Text="{Binding TotalFundBalanceDisplay}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource TealBrush}"/><TextBlock Text="Active configured funds" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,8,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE825;" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Total Bank Balance" Style="{StaticResource KpiTitleStyle}"/><TextBlock Text="{Binding BankingWorkspace.TotalBookBalanceDisplay}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Book balances" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource DashboardCardStyle}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource WarningSoftBrush}" VerticalAlignment="Top"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Foreground="{DynamicResource WarningBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="BIR Status" Style="{StaticResource KpiTitleStyle}"/><TextBlock Text="Setup Required" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource WarningBrush}" FontSize="15"/><TextBlock Text="Tax module not active yet" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <!-- Simple / Pro / Accountant stays in the approved dashboard position. -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding SelectSimpleModeCommand}" Content="Simple">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspaceMode}" Value="Simple"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Command="{Binding SelectProModeCommand}" Content="Pro">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspaceMode}" Value="Pro"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Command="{Binding SelectAccountantModeCommand}" Content="Accountant">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspaceMode}" Value="Accountant"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <TextBlock Text="{Binding ModeExplanation}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                <Button Command="{Binding RefreshDashboardCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Padding="10,4" MinHeight="28" FontSize="9" HorizontalAlignment="Right" Margin="12,0,0,0" />
                            </StackPanel>

                            <!-- Primary dashboard row -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.32*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="0.72*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Service Financial Report" Style="{StaticResource DashboardSectionTitleStyle}"/><Button Grid.Column="1" Command="{Binding ShowReportsCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="View Reports" Padding="8,4" MinHeight="26" FontSize="9"/></Grid>
                                        <StackPanel Grid.Row="1" Margin="0,4,0,5"><TextBlock Text="{Binding LatestServiceDisplay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding LatestServiceCaption}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                                        <UniformGrid Grid.Row="2" Columns="4">
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="0,0,6,0" Padding="7"><StackPanel><TextBlock Text="Service Batches" FontWeight="SemiBold" FontSize="9"/><TextBlock Text="{Binding GivingWorkspace.Batches.Count}" Foreground="{DynamicResource SuccessBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="0,0,6,0" Padding="7"><StackPanel><TextBlock Text="Giving This Month" FontWeight="SemiBold" FontSize="9"/><TextBlock Text="{Binding GivingWorkspace.ChurchMonthTotal}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="0,0,6,0" Padding="7"><StackPanel><TextBlock Text="Posted Deposits" FontWeight="SemiBold" FontSize="9"/><TextBlock Text="{Binding BankingWorkspace.PostedDepositCount}" Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7"><StackPanel><TextBlock Text="Posted Expenses" FontWeight="SemiBold" FontSize="9"/><TextBlock Text="{Binding ExpensesWorkspace.PostedExpenseCount}" Foreground="{DynamicResource DangerBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                        </UniformGrid>
                                        <TextBlock Grid.Row="3" Text="ChurchBooks keeps offering capture, deposits, expenses, and General Ledger posting traceable. A complete after-service filing package will expand as later reporting phases land." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Giving by Category" Style="{StaticResource DashboardSectionTitleStyle}"/><TextBlock Grid.Column="1" Text="This Month" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center"/></Grid>
                                        <controls:OfferingChartControl Grid.Row="1" Points="{Binding GivingWorkspace.ChurchMonthCategoryPoints}" ChartKind="Donut" Margin="0,8,0,0" />
                                    </Grid>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource DashboardCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Quick Actions" Style="{StaticResource DashboardSectionTitleStyle}" Margin="0,0,0,5"/>
                                        <Button Command="{Binding ShowGivingCommand}" Style="{StaticResource QuickActionButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB51;" Foreground="{DynamicResource SuccessBrush}" FontSize="15" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Record Offering" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Add a giving entry" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button>
                                        <Button Command="{Binding ShowImportCommand}" Style="{StaticResource QuickActionButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" Foreground="{DynamicResource AccentBrush}" FontSize="15" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Import Excel or CSV" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Preview and stage only" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button>
                                        <Button Command="{Binding ShowBankingCommand}" Style="{StaticResource QuickActionButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE825;" Foreground="{DynamicResource PurpleBrush}" FontSize="15" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Reconcile Bank" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Match bank activity" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button>
                                        <Button Command="{Binding ShowReportsCommand}" Style="{StaticResource QuickActionButtonStyle}" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" Foreground="{DynamicResource WarningBrush}" FontSize="15" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Generate Report" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Open financial reports" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bank / recent activity / fund balance row -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.27*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="0.72*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Bank Accounts" Style="{StaticResource DashboardSectionTitleStyle}"/><Button Grid.Column="1" Command="{Binding ShowBankingCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="View All" Padding="8,4" MinHeight="26" FontSize="9"/></Grid>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding BankingWorkspace.BankAccounts}" AutoGenerateColumns="False" Margin="0,5,0,3" RowHeight="26" ColumnHeaderHeight="27" FontSize="9" IsReadOnly="True">
                                            <DataGrid.Columns><DataGridTextColumn Header="Account Name" Binding="{Binding Name}" Width="*" MinWidth="120"/><DataGridTextColumn Header="Institution" Binding="{Binding Institution}" Width="110"/><DataGridTextColumn Header="Book Balance" Binding="{Binding BalanceDisplay}" Width="120"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="72"/></DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="2" Text="{Binding BankingWorkspace.TotalBookBalanceDisplay, StringFormat='Total bank balance: {0}'}" FontWeight="SemiBold" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Recent Transactions" Style="{StaticResource DashboardSectionTitleStyle}"/><TextBlock Grid.Column="1" Text="Posted activity" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center"/></Grid>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding DashboardTransactions}" AutoGenerateColumns="False" Margin="0,5,0,3" RowHeight="26" ColumnHeaderHeight="27" FontSize="9" IsReadOnly="True">
                                            <DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="78"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="130"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/><DataGridTextColumn Header="Amount" Binding="{Binding AmountDisplay}" Width="105"/></DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="2" Text="Only explicitly posted deposit/expense activity is shown; ChurchBooks does not invent journal rows." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource DashboardCardStyle}">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Fund Balances" Style="{StaticResource DashboardSectionTitleStyle}"/><Button Grid.Column="1" Command="{Binding ShowFundsCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="View" Padding="7,3" MinHeight="24" FontSize="8"/></Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DashboardFundBalances}" Margin="0,5,0,0">
                                            <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RestrictionLabel}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Balance, StringFormat=N2}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Row="2" Text="{Binding TotalFundBalanceDisplay, StringFormat='Total funds: {0}'}" FontWeight="SemiBold" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Readiness and reminders row -->
                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.75*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="BIR Readiness" Style="{StaticResource DashboardSectionTitleStyle}"/><TextBlock Text="Books of Accounts / General Ledger" FontSize="9" Margin="0,9,0,0"/><TextBlock Text="Bank reconciliation workflow" FontSize="9" Margin="0,5,0,0"/><TextBlock Text="Revenue and expense source data" FontSize="9" Margin="0,5,0,0"/><TextBlock Text="BIR forms, validation, and e-filing" FontSize="9" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="Available" Foreground="{DynamicResource SuccessBrush}" FontSize="9" Margin="0,27,0,0" HorizontalAlignment="Right"/><TextBlock Text="Available" Foreground="{DynamicResource SuccessBrush}" FontSize="9" Margin="0,5,0,0" HorizontalAlignment="Right"/><TextBlock Text="Available" Foreground="{DynamicResource SuccessBrush}" FontSize="9" Margin="0,5,0,0" HorizontalAlignment="Right"/><TextBlock Text="Not implemented" Foreground="{DynamicResource WarningBrush}" FontSize="9" Margin="0,5,0,0" HorizontalAlignment="Right"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="System Alerts &amp; Reminders" Style="{StaticResource DashboardSectionTitleStyle}"/><TextBlock Grid.Column="1" Text="No automatic accounting changes" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8" VerticalAlignment="Center"/></Grid>
                                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,6,0,0">
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="9" Margin="0,0,8,0"><StackPanel><TextBlock Text="Organization Setup" FontWeight="SemiBold" FontSize="9"/><TextBlock Text="{Binding OrganizationSetupAlert}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                                            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="7" Padding="9" Margin="0,0,8,0"><StackPanel><TextBlock Text="Banking Review" FontWeight="SemiBold" FontSize="9"/><TextBlock Text="{Binding BankingAlert}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                                            <Border Background="{DynamicResource PurpleSoftBrush}" CornerRadius="7" Padding="9"><StackPanel><TextBlock Text="Backup &amp; Recovery" FontWeight="SemiBold" FontSize="9"/><TextBlock Text="{Binding BackupAlert}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsPeopleVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding SetupWorkspace.MemberPlural}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Manage members, donors, households, and configurable giving categories. This directory does not post accounting transactions." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Active People" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding PeopleWorkspace.ActivePeopleCount}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Active Households" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding PeopleWorkspace.ActiveHouseholdCount}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Giving Categories" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding PeopleWorkspace.ActiveGivingCategoryCount}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
                    </UniformGrid>

                    <TabControl Grid.Row="2">
                        <TabItem Header="{Binding SetupWorkspace.MemberPlural}">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, member number, household, role, or email" automation:AutomationProperties.Name="Search people" />
                                    <CheckBox Grid.Column="1" Content="Include archived" IsChecked="{Binding PeopleWorkspace.IncludeArchived}" VerticalAlignment="Center" Margin="12,0" />
                                    <Button Grid.Column="2" Command="{Binding PeopleWorkspace.NewPersonCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="New Person" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="420" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1*" MinWidth="300" /></Grid.ColumnDefinitions>
                                    <DataGrid Grid.Column="0" ItemsSource="{Binding PeopleWorkspace.People}" SelectedItem="{Binding PeopleWorkspace.SelectedPerson}" AutoGenerateColumns="False" IsReadOnly="True" automation:AutomationProperties.Name="Members and donors">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Converter={StaticResource PersonFullNameConverter}}" Width="*" MinWidth="145" />
                                            <DataGridTextColumn Header="Role" Binding="{Binding RoleLabel}" Width="110" />
                                            <DataGridTextColumn Header="Member #" Binding="{Binding MemberNumber}" Width="100" />
                                            <DataGridTextColumn Header="Household" Binding="{Binding HouseholdName}" Width="140" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="85" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="Person Details" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="First / given name(s)" Margin="0,10,0,4" ToolTip="Enter all given names, for example Alvin Joseph. Digits are not accepted."/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.PersonFirstName, UpdateSourceTrigger=PropertyChanged}" behaviors:PersonNameTextBoxBehavior.IsEnabled="True" ToolTip="Enter all given names. ChurchBooks title-cases person names when you leave the field." automation:AutomationProperties.Name="First or given names"/>
                                                <TextBlock Text="Include every given name here so donor lists can show the complete name, for example Alvin Joseph Tan." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock Text="Last name" Margin="0,8,0,4"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.PersonLastName, UpdateSourceTrigger=PropertyChanged}" behaviors:PersonNameTextBoxBehavior.IsEnabled="True" ToolTip="Person last name. Digits are not accepted; capitalization is normalized when you leave the field."/>
                                                <TextBlock Text="Preferred name" Margin="0,8,0,4"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.PersonPreferredName, UpdateSourceTrigger=PropertyChanged}" behaviors:PersonNameTextBoxBehavior.IsEnabled="True" ToolTip="Optional familiar name. Digits are not accepted."/>
                                                <WrapPanel Margin="0,8,0,0"><CheckBox Content="{Binding SetupWorkspace.MemberSingular}" IsChecked="{Binding PeopleWorkspace.PersonIsMember}" Margin="0,0,14,0" /><CheckBox Content="{Binding SetupWorkspace.DonorSingular}" IsChecked="{Binding PeopleWorkspace.PersonIsDonor}" /></WrapPanel>
                                                <TextBlock Text="Member number" Margin="0,8,0,4" /><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.PersonMemberNumber, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Household" Margin="0,8,0,4" /><ComboBox ItemsSource="{Binding PeopleWorkspace.Households}" SelectedItem="{Binding PeopleWorkspace.PersonHousehold}" DisplayMemberPath="Name" />
                                                <TextBlock Text="Email" Margin="0,8,0,4" /><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.PersonEmail, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Phone" Margin="0,8,0,4" /><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.PersonPhone, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{Binding PeopleWorkspace.PersonError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                <WrapPanel Margin="0,10,0,0"><Button Command="{Binding PeopleWorkspace.SavePersonCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Save Person" Margin="0,0,8,0" /><Button Command="{Binding PeopleWorkspace.EditPersonCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Edit Selected" Margin="0,0,8,0" ToolTip="Load the selected member/donor into the editor so names, roles, member number, household, email, and phone can be updated." /><Button Command="{Binding PeopleWorkspace.ArchiveOrReactivatePersonCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Archive / Reactivate" /></WrapPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Households">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="420" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1*" MinWidth="300" /></Grid.ColumnDefinitions>
                                <DataGrid Grid.Column="0" ItemsSource="{Binding PeopleWorkspace.Households}" SelectedItem="{Binding PeopleWorkspace.SelectedHousehold}" AutoGenerateColumns="False" IsReadOnly="True" automation:AutomationProperties.Name="Household list">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Household" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Statement Name" Binding="{Binding StatementName}" Width="*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Household Details" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Household name" Margin="0,10,0,4" /><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.HouseholdName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Giving statement name" Margin="0,8,0,4" /><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.HouseholdStatementName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding PeopleWorkspace.HouseholdError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <WrapPanel Margin="0,10,0,0"><Button Command="{Binding PeopleWorkspace.SaveHouseholdCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Save Household" Margin="0,0,8,0" /><Button Command="{Binding PeopleWorkspace.NewHouseholdCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="New" Margin="0,0,8,0" /><Button Command="{Binding PeopleWorkspace.EditHouseholdCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Load Selected" Margin="0,0,8,0" /><Button Command="{Binding PeopleWorkspace.ArchiveOrReactivateHouseholdCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Archive / Reactivate" /></WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>


                    </TabControl>

                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Background="{DynamicResource AccentSoftBrush}" Margin="0,12,0,0">
                        <TextBlock Text="{Binding PeopleWorkspace.StatusMessage}" TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsFundsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Fund Manager" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Track what money is designated for without confusing it with where the money is physically held." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding RefreshFundsCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Margin="0,0,8,0" automation:AutomationProperties.Name="Refresh fund balances" />
                            <Button Command="{Binding AddFundCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Add Fund" automation:AutomationProperties.Name="Add new fund" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,0,12"
                            Visibility="{Binding ShowGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Bank Account" FontWeight="SemiBold" />
                                <TextBlock Text="Where money is held, such as BPI Checking or BDO Savings." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="Fund" FontWeight="SemiBold" />
                                <TextBlock Text="What money is designated for. Funds are configured by your church and are never fixed in offering forms, reports, or charts." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Account or Category" FontWeight="SemiBold" />
                                <TextBlock Text="Why money was received or spent. It describes activity; it is not the fund balance." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,12">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12">
                            <StackPanel><TextBlock Text="Active Funds" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding ActiveFundCount}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12">
                            <StackPanel><TextBlock Text="Donor Restricted or Endowment" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding RestrictedFundCount}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="12">
                            <StackPanel><TextBlock Text="Tracked Fund Balance" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding TotalFundBalanceDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" /></StackPanel>
                        </Border>
                    </UniformGrid>

                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  automation:AutomationProperties.Name="Fund Manager workspace scroll region">
                        <Grid MinWidth="820">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.1*" MinWidth="540" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" MinWidth="270" />
                            </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding FundSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search code, name, purpose, or restriction" automation:AutomationProperties.Name="Search funds" />
                                    <CheckBox Grid.Column="1" Content="Include archived" IsChecked="{Binding IncludeArchived}" VerticalAlignment="Center" Margin="12,0,0,0" automation:AutomationProperties.Name="Include archived funds" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <DataGrid ItemsSource="{Binding Funds}" SelectedItem="{Binding SelectedFund}" AutoGenerateColumns="False" Margin="12,0,12,12"
                                              automation:AutomationProperties.Name="Fund list">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                            <DataGridTextColumn Header="Fund" Binding="{Binding Name}" Width="*" MinWidth="170" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding RestrictionLabel}" Width="135" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="85" />
                                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDisplay}" Width="125" />
                                            <DataGridTextColumn Header="Safeguard" Binding="{Binding OverspendLabel}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Background="{DynamicResource SurfaceBrush}" Margin="12" Padding="28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNoFunds}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                            <TextBlock Text="No funds to show" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="Start with a General Fund, or add the fund structure your church already uses. Nothing is posted automatically." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,14" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding CreateGeneralFundCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Create General Fund" Margin="0,0,8,0" />
                                                <Button Command="{Binding AddFundCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Add Custom Fund" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                            <Grid>
                                <StackPanel x:Name="FundDetailsPanel">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFundEditorOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Fund Details" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedFund.Name, TargetNullValue='Select a fund'}" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding SelectedFund.Code}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Balance" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedFund.BalanceDisplay, TargetNullValue='PHP 0.00'}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Status" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedFund.StatusLabel, TargetNullValue='No selection'}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Purpose" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,0" />
                                    <TextBlock Text="{Binding SelectedFund.Purpose, TargetNullValue='Select a fund to review its purpose.'}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                    <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8" Padding="10" Margin="0,16,0,0"
                                            Visibility="{Binding ShowAdvancedFundDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="Accounting Detail" FontWeight="SemiBold" />
                                            <TextBlock Text="Restriction" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                                            <TextBlock Text="{Binding SelectedFund.RestrictionLabel, TargetNullValue='-'}" />
                                            <TextBlock Text="Overspending safeguard" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                                            <TextBlock Text="{Binding SelectedFund.OverspendLabel, TargetNullValue='-'}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button Command="{Binding EditFundCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Edit" Margin="0,0,8,0" />
                                        <Button Command="{Binding ArchiveOrReactivateFundCommand}" Style="{StaticResource DangerButtonStyle}" Content="{Binding SelectedFundActionLabel}" />
                                    </StackPanel>

                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,18,0,0" Visibility="{Binding ShowGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding FundTerminologyHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <ScrollViewer x:Name="FundEditorPanel" VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFundEditorOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding EditorTitle}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Nothing is posted by this form. It only maintains the fund master record." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,14" />

                                        <TextBlock Text="Fund code" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding EditorCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" automation:AutomationProperties.Name="Fund code" />
                                        <TextBlock Text="{Binding EditorCodeError}" Style="{StaticResource FieldErrorStyle}" />

                                        <TextBlock Text="Fund name" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" automation:AutomationProperties.Name="Fund name" />
                                        <TextBlock Text="{Binding EditorNameError}" Style="{StaticResource FieldErrorStyle}" />

                                        <TextBlock Text="Restriction" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5" />
                                        <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding FundRestrictions}" SelectedItem="{Binding EditorRestriction}" automation:AutomationProperties.Name="Fund restriction" />

                                        <TextBlock Text="Overspending safeguard" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5" />
                                        <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding OverspendPolicies}" SelectedItem="{Binding EditorOverspendPolicy}" automation:AutomationProperties.Name="Fund overspending safeguard" />

                                        <TextBlock Text="Purpose" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding EditorPurpose, UpdateSourceTrigger=PropertyChanged}" MaxLength="400" Height="86" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" automation:AutomationProperties.Name="Fund purpose" />
                                        <TextBlock Text="{Binding EditorPurposeError}" Style="{StaticResource FieldErrorStyle}" />

                                        <TextBlock Text="{Binding EditorGeneralError}" Style="{StaticResource FieldErrorStyle}" Margin="0,12,0,0" />

                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button Command="{Binding SaveFundCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Save Fund" Margin="0,0,8,0" />
                                            <Button Command="{Binding CancelFundEditCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsServicesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <views:ServicesWorkspaceView DataContext="{Binding GivingWorkspace}" />
                </Grid>
                <Grid Visibility="{Binding IsGivingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <views:GivingWorkspaceView DataContext="{Binding GivingWorkspace}" />
                </Grid>
                <Grid Visibility="{Binding IsBankingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <views:BankingWorkspaceView DataContext="{Binding BankingWorkspace}" />
                </Grid>
                <Grid Visibility="{Binding IsExpensesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <views:ExpensesWorkspaceView DataContext="{Binding ExpensesWorkspace}" />
                </Grid>
                <Grid Visibility="{Binding IsImportVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <views:ImportWorkspaceView DataContext="{Binding ImportWorkspace}" />
                </Grid>
                <Grid Visibility="{Binding IsSetupVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Organization, branding, appearance, terminology, and guidance preferences" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <TabControl Grid.Row="1" Margin="14,10,14,12">
                        <TabItem Header="Organization &amp; Terminology">
                            <views:SetupWorkspaceView DataContext="{Binding SetupWorkspace}" />
                        </TabItem>
                        <TabItem Header="Giving Setup">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CardStyle}" Padding="14">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Giving Categories" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock Text="Set up contribution categories here. Transaction screens only select configured categories; they never invent or duplicate Tithes automatically." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                            </StackPanel>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" MinWidth="330"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*" MinWidth="290"/></Grid.ColumnDefinitions>
                                                <DataGrid Grid.Column="0" ItemsSource="{Binding PeopleWorkspace.GivingCategories}" SelectedItem="{Binding PeopleWorkspace.SelectedGivingCategory}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="320" automation:AutomationProperties.Name="Configured giving categories">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/>
                                                        <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="*"/>
                                                        <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="130"/>
                                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Category Details" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Code" Margin="0,8,0,4"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.CategoryCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="Short accounting/report code for this giving category."/>
                                                    <TextBlock Text="Name" Margin="0,8,0,4"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.CategoryName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Giving category name, for example Tithes, Missions, or Love Offering."/>
                                                    <TextBlock Text="Report group" Margin="0,8,0,4"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.CategoryGroupName, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="Description" Margin="0,8,0,4"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PeopleWorkspace.CategoryDescription, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="62"/>
                                                    <TextBlock Text="{Binding PeopleWorkspace.CategoryError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                    <WrapPanel Margin="0,10,0,0"><Button Command="{Binding PeopleWorkspace.SaveGivingCategoryCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Save Category" Margin="0,0,8,0"/><Button Command="{Binding PeopleWorkspace.NewGivingCategoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="New" Margin="0,0,8,0"/><Button Command="{Binding PeopleWorkspace.EditGivingCategoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Load Selected" Margin="0,0,8,0"/><Button Command="{Binding PeopleWorkspace.ArchiveOrReactivateGivingCategoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Remove / Restore"/></WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Related Setup" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="ChurchBooks keeps setup separate from transaction entry. Use these shortcuts when a Giving field is empty." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                            <Button Command="{Binding ShowFundsCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Content="Open Fund Manager" Margin="0,0,0,8" ToolTip="Create, rename, archive, or review church funds."/>
                                            <Button Command="{Binding ShowServicesCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Content="Open Services" Margin="0,0,0,8" ToolTip="Create or close service batches used by Giving."/>
                                            <Button Command="{Binding ShowMembersCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Content="Register Donor / Member" ToolTip="People registration stays under Members rather than Settings."/>
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,14,0,0"><TextBlock Text="Setup rule: Giving Category and Fund are configured before entry. Donor/member registration remains under Members. Reference and Memo are optional transaction details." TextWrapping="Wrap" FontSize="10"/></Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Branding &amp; Theme">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardStyle}" Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="Organization Branding" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock Text="Use your church or organization logo inside ChurchBooks. The ChurchBooks product logo remains the application identity." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/>
                                                <Border Width="180" Height="120" HorizontalAlignment="Left" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                                                    <Grid>
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE825;" FontSize="42" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding OrganizationLogoPath}" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="PNG or JPEG, up to 10 MB. A managed copy is stored under your local ChurchBooks profile." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                    <Button Click="ChooseOrganizationLogo_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Choose Logo" Margin="0,0,8,0"/>
                                                    <Button Command="{Binding RemoveOrganizationLogoCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Remove Logo"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock Text="ChurchBooks Light is the recommended default. Dark uses slate/navy surfaces for long accounting sessions rather than pure AMOLED black." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/>
                                                <Button Command="{Binding SelectChurchBooksLightThemeCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="28" CornerRadius="6" Background="#F7F7F3" BorderBrush="#E4E2DA" BorderThickness="1"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="ChurchBooks Light" FontWeight="SemiBold"/><TextBlock Text="Warm dirty-white / soft ivory — recommended" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/></StackPanel></Grid>
                                                </Button>
                                                <Button Command="{Binding SelectClassicWhiteThemeCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="28" CornerRadius="6" Background="#FFFFFF" BorderBrush="#DDE4EC" BorderThickness="1"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Classic White" FontWeight="SemiBold"/><TextBlock Text="Bright traditional accounting workspace" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/></StackPanel></Grid>
                                                </Button>
                                                <Button Command="{Binding SelectChurchBooksDarkThemeCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Stretch">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="28" CornerRadius="6" Background="#111827" BorderBrush="#334155" BorderThickness="1"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="ChurchBooks Dark" FontWeight="SemiBold"/><TextBlock Text="Slate/navy dark theme — not pure black" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/></StackPanel></Grid>
                                                </Button>
                                                <TextBlock Text="{Binding SelectedAppearanceTheme, StringFormat=Current theme: {0}}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Guidance &amp; Workspace">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">
                                    <Border Style="{StaticResource CardStyle}" Padding="16" MaxWidth="850" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="Guidance Level" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="Choose how much explanatory help ChurchBooks shows while keeping the same accounting logic underneath." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                            <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{Binding HelpLevels}" SelectedItem="{Binding SelectedHelpLevel}" automation:AutomationProperties.Name="Help level"/>
                                            <Separator Margin="0,16"/>
                                            <TextBlock Text="Workspace Detail" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="Simple, Pro, and Accountant change how much accounting context is shown; they do not create different books." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Command="{Binding SelectSimpleModeCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Simple" Margin="0,0,8,0"/>
                                                <Button Command="{Binding SelectProModeCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Pro" Margin="0,0,8,0"/>
                                                <Button Command="{Binding SelectAccountantModeCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Accountant"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ModeExplanation}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Backup &amp; Recovery">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardStyle}" Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="Backup Location" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock Text="Choose where ChurchBooks stores manual database snapshots. Backups use SQLite's online backup API so WAL-mode transactions are captured consistently." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                                <TextBlock Text="Backup folder" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBox Text="{Binding BackupDirectory}" IsReadOnly="True" Margin="0,5,0,10" automation:AutomationProperties.Name="Backup folder"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Click="ChooseBackupFolder_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Choose Folder" Margin="0,0,8,0"/>
                                                    <Button Click="OpenBackupFolder_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Open Folder"/>
                                                </StackPanel>
                                                <Separator Margin="0,16"/>
                                                <TextBlock Text="Last verified backup" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Text="{Binding LastBackupDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding LastBackupPath}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="Backup &amp; Recovery" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock Text="Create a verified snapshot before important changes. Restore always validates the selected backup and creates a pre-restore safety backup before replacing the local books." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                                <Button Click="BackUpNow_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Back Up Now" HorizontalAlignment="Stretch" Margin="0,0,0,8" automation:AutomationProperties.Name="Back up ChurchBooks now"/>
                                                <Button Click="VerifyBackup_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Verify Backup File..." HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                                <Button Click="RestoreBackup_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Restore Backup..." HorizontalAlignment="Stretch"/>
                                                <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                                                    <TextBlock Text="Restore is replacement, not merge. ChurchBooks never silently combines two accounting databases. A confirmation and pre-restore safety backup are required." TextWrapping="Wrap" FontSize="10"/>
                                                </Border>
                                                <TextBlock Text="{Binding BackupOperationStatus}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Grid Visibility="{Binding IsReportsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Reports Center" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="Generate board-ready reports from posted ChurchBooks data. Available reports are clearly separated from reporting areas planned for later phases." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Image Grid.Column="1" Source="{Binding OrganizationLogoPath}" Width="48" Height="38" Stretch="Uniform" Margin="12,0"/>
                        <Button Grid.Column="2" Command="{Binding RefreshReportsCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Generate Reports" automation:AutomationProperties.Name="Generate reports"/>
                    </Grid>
                    <TabControl Grid.Row="1">
                        <TabItem Header="Fund Reports">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="12"><StackPanel><TextBlock Text="Fund Balance Snapshot" FontWeight="SemiBold"/><TextBlock Text="As-of balances, restriction, status, and total restricted balance." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0" Padding="12"><StackPanel><TextBlock Text="Fund Activity" FontWeight="SemiBold"/><TextBlock Text="Opening balance, increases, decreases, closing balance, and ledger detail for a selected fund." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                                </UniformGrid>
                                <TabControl Grid.Row="1">
                                    <TabItem Header="Fund Balances">
                                        <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="As of" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker Grid.Column="1" SelectedDate="{Binding ReportAsOfDate}"/><Button Grid.Column="3" Command="{Binding ExportFundBalanceCsvCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Export CSV"/></Grid>
                                            <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,10"><TextBlock Text="{Binding BalanceReportSummary}" TextWrapping="Wrap"/></Border>
                                            <Grid Grid.Row="2"><DataGrid ItemsSource="{Binding FundBalanceReportRows}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="Fund" Binding="{Binding Name}" Width="*" MinWidth="180"/><DataGridTextColumn Header="Restriction" Binding="{Binding Restriction}" Width="145"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="130"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FundBalanceReportRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="34" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock Text="No fund report rows yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Create funds and post fund-aware activity, then generate this report." Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Fund Activity">
                                        <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Fund" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Funds}" SelectedItem="{Binding ReportFund}" DisplayMemberPath="Name"/><TextBlock Grid.Column="2" Text="From" VerticalAlignment="Center" Margin="12,0,8,0"/><DatePicker Grid.Column="3" SelectedDate="{Binding ActivityFromDate}"/><TextBlock Grid.Column="4" Text="To" VerticalAlignment="Center" Margin="12,0,8,0"/><DatePicker Grid.Column="5" SelectedDate="{Binding ActivityToDate}"/><Button Grid.Column="7" Command="{Binding ExportFundActivityCsvCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Export CSV"/></Grid>
                                            <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,10"><TextBlock Text="{Binding ActivityReportSummary}" TextWrapping="Wrap"/></Border>
                                            <DataGrid Grid.Row="2" ItemsSource="{Binding FundActivityReportLines}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding PostingDate}" Width="105"/><DataGridTextColumn Header="Entry" Binding="{Binding EntryNumber}" Width="110"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="180"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="120"/><DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Fund Impact" Binding="{Binding NetAssetImpact, StringFormat=N2}" Width="115"/></DataGrid.Columns></DataGrid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Accountant Reports">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <TextBlock Text="Accountant reports are generated only from posted journal activity. Trial Balance, Income &amp; Expense, and General Ledger are available now. Balance Sheet remains deferred until its fiscal-year/equity presentation contract is separately verified." TextWrapping="Wrap"/>
                                </Border>
                                <TabControl Grid.Row="1">
                                    <TabItem Header="Trial Balance">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="As of" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <DatePicker Grid.Column="1" SelectedDate="{Binding FinancialReportAsOfDate}"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <Button Command="{Binding RefreshReportsCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Generate" Margin="0,0,8,0"/>
                                                    <Button Command="{Binding ExportTrialBalanceCsvCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Export CSV"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,10"><TextBlock Text="{Binding TrialBalanceSummary}" TextWrapping="Wrap"/></Border>
                                            <DataGrid Grid.Row="2" ItemsSource="{Binding TrialBalanceRows}" AutoGenerateColumns="False">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="95"/>
                                                    <DataGridTextColumn Header="Account" Binding="{Binding Name}" Width="*" MinWidth="220"/>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                                                    <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="130"/>
                                                    <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="130"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Income &amp; Expense">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <DatePicker Grid.Column="1" SelectedDate="{Binding FinancialFromDate}"/>
                                                <TextBlock Grid.Column="2" Text="To" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                                <DatePicker Grid.Column="3" SelectedDate="{Binding FinancialToDate}"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                                    <Button Command="{Binding RefreshReportsCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Generate" Margin="0,0,8,0"/>
                                                    <Button Command="{Binding ExportIncomeExpenseCsvCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Export CSV"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,10"><TextBlock Text="{Binding IncomeExpenseSummary}" TextWrapping="Wrap"/></Border>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource CardStyle}" Padding="10">
                                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Income" FontSize="15" FontWeight="SemiBold"/><DataGrid Grid.Row="1" ItemsSource="{Binding IncomeReportRows}" AutoGenerateColumns="False" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="85"/><DataGridTextColumn Header="Account" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid></Grid>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Expenses" FontSize="15" FontWeight="SemiBold"/><DataGrid Grid.Row="1" ItemsSource="{Binding ExpenseReportRows}" AutoGenerateColumns="False" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="85"/><DataGridTextColumn Header="Account" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid></Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="General Ledger">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Account" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding ReportAccounts}" SelectedItem="{Binding GeneralLedgerAccount}" DisplayMemberPath="Name"/>
                                                <TextBlock Grid.Column="2" Text="From" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                                <DatePicker Grid.Column="3" SelectedDate="{Binding FinancialFromDate}"/>
                                                <TextBlock Grid.Column="4" Text="To" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                                <DatePicker Grid.Column="5" SelectedDate="{Binding FinancialToDate}"/>
                                                <StackPanel Grid.Column="7" Orientation="Horizontal">
                                                    <Button Command="{Binding RefreshReportsCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Generate" Margin="0,0,8,0"/>
                                                    <Button Command="{Binding ExportGeneralLedgerCsvCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Export CSV"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,10"><TextBlock Text="{Binding GeneralLedgerSummary}" TextWrapping="Wrap"/></Border>
                                            <DataGrid Grid.Row="2" ItemsSource="{Binding GeneralLedgerRows}" AutoGenerateColumns="False">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Date" Binding="{Binding PostingDate}" Width="105"/>
                                                    <DataGridTextColumn Header="Entry" Binding="{Binding EntryNumber}" Width="105"/>
                                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="190"/>
                                                    <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="115"/>
                                                    <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="100"/>
                                                    <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="100"/>
                                                    <DataGridTextColumn Header="Running" Binding="{Binding RunningBalance, StringFormat=N2}" Width="120"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Giving Reports">
                            <StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Giving Reports" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Individual and whole-church giving analytics are available now under Giving → Individual Analytics. Formal donor statements and annual contribution statement exports will be added in a later verified reporting phase." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/></StackPanel>
                        </TabItem>
                        <TabItem Header="Bank &amp; Expense Reports">
                            <StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Bank &amp; Expense Reports" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Bank reconciliation detail and expense/vendor reporting will appear here when their report contracts are complete. Existing banking, reconciliation, and direct-expense records remain available in their workspaces." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/></StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Grid Visibility="{Binding IsIntegrityVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Audit &amp; Integrity" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Read-only health checks help protect fund assignments, balances, restrictions, archives, and database relationships. No scan posts accounting entries." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Command="{Binding RunIntegrityScanCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Run Integrity Scan"/></Grid>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12"><Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12"><StackPanel><TextBlock Text="Critical Findings" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding IntegrityCriticalCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12"><StackPanel><TextBlock Text="Warnings" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding IntegrityWarningCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Background="{DynamicResource AccentSoftBrush}" Padding="12"><TextBlock Text="{Binding IntegritySummary}" TextWrapping="Wrap" VerticalAlignment="Center"/></Border></UniformGrid>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Integrity Findings" FontSize="16" FontWeight="SemiBold"/><Grid Grid.Row="1" Margin="0,10,0,0"><DataGrid ItemsSource="{Binding IntegrityFindings}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="110"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="190"/><DataGridTextColumn Header="Finding" Binding="{Binding Message}" Width="*" MinWidth="320"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IntegrityFindings.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="34" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/><TextBlock Text="No integrity findings" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Run a scan whenever you want to re-check the local books. A clean result does not change any accounting data." Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid></Grid></Border>
                    <Expander Grid.Row="3" Header="Advanced Review Tools" Margin="0,12,0,0" IsExpanded="False"><Border Style="{StaticResource CardStyle}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Restriction Release Review — preview only; no journal is posted" FontSize="15" FontWeight="SemiBold"/><Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Funds}" SelectedItem="{Binding ReportFund}" DisplayMemberPath="Name" Margin="0,0,8,0"/><TextBox Grid.Column="1" Text="{Binding ReleaseAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" HorizontalContentAlignment="Right" behaviors:AccountingAmountTextBoxBehavior.IsEnabled="True" ToolTip="Release amount. Digits, comma grouping, and one decimal point are accepted; display format is x,xxx.xx."/><TextBox Grid.Column="2" Text="{Binding ReleaseEvidence, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Evidence that donor restriction was satisfied"/><Button Grid.Column="3" Command="{Binding ReviewRestrictionReleaseCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Review"/></Grid><TextBlock Grid.Row="2" Text="{Binding ReleaseReviewResult}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/></Grid></Border></Expander>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SystemStatusDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding DatabaseConnectionDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding BackupFooterDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="Development build" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock Grid.Column="4" Text="Help" Foreground="{DynamicResource AccentBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
