<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ChurchBooks Light is the default startup palette. ThemeManager mutates these
         exact brush resources in-place, including this merged dictionary, so shared
         styles and templates change together instead of leaving light-theme islands. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F7F7F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFEFB" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F5F4EF" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ShellBrush" Color="#FFFEFB" />
    <SolidColorBrush x:Key="ShellMutedBrush" Color="#F5F4EF" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#F4F3EE" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E2DA" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D2D0C7" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#98A2B3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1677E8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0D68D4" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF3FF" />
    <SolidColorBrush x:Key="AccentContrastBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#149A68" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E8F8F0" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C87514" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF4E7" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C43C4A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFF0F2" />
    <SolidColorBrush x:Key="TealBrush" Color="#0C9A9A" />
    <SolidColorBrush x:Key="TealSoftBrush" Color="#E9F8F8" />
    <SolidColorBrush x:Key="PurpleBrush" Color="#7955D8" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#F2ECFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#DCEBFF" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#F0F1EC" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#A6AAA6" />
</ResourceDictionary>
